# Optional: replace the public PeerJS signaling service with your own.
# VITE_PEER_HOST=your-signaling.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Optional TURN relay for restrictive firewalls / symmetric NAT.
# These are public browser variables: use short-lived TURN credentials in production.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-relay.example.com:3478","username":"temporary-user","credential":"temporary-credential"}]
